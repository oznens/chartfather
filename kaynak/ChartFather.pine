//@version=6
strategy("ChartFather Bot", overlay=true, max_labels_count=200, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=100)

// Timeframe kontrolü
if timeframe.period != "5"
    runtime.error("Bu strateji sadece 5 dakikalık grafiklerde çalışır!")

var box[] supplyZones = array.new_box(0)
var box[] demandZones = array.new_box(0)
var int[] supplyTimestamps = array.new_int(0) // Zaman damgaları
var int[] demandTimestamps = array.new_int(0) // Zaman damgaları
var label[] supplyLabels = array.new_label(0) // Supply bölgeleri için label'lar
var label[] demandLabels = array.new_label(0) // Demand bölgeleri için label'lar

// Strateji parametreleri
var float stopLossPercent = input.float(0.2, "Stop Loss %", minval=0.1, step=0.1)
var float riskRewardRatio = input.float(2.0, "Risk/Reward Oranı", minval=1.0, step=0.1)
var float maxFvgFill = input.float(90.0, "Maksimum FVG Doluluk %", minval=0.0, maxval=100.0)

// Body oranını hesaplayan fonksiyon
bodyRate() =>
    epsilon = 0.00001  // Minimum değer eşiği
    
    bodySize = float(math.abs(open - close))
    prevBodySize = float(math.abs(open[1] - close[1]))
    
    // Eğer bodySize veya prevBodySize sıfıra yakınsa epsilon'a eşitle
    bodySize := bodySize == 0.0 ? epsilon : bodySize
    prevBodySize := prevBodySize == 0.0 ? epsilon : prevBodySize
    
    Rate = bodySize / prevBodySize 
    Rate >= 1.5

currentHigh = high
currentLow = low
currentOpen = open
currentClose = close
previousOpen = open[1]
previousClose = close[1]
previousHigh = high[1]
previousLow = low[1]

// Supply Zone tespiti
if (currentOpen > currentClose)
    if (previousOpen <= previousClose)
        //supply
        if (currentLow < previousLow)
            if bodyRate()
                if (currentHigh < previousHigh)
                    LabelSupply = label.new(bar_index[1], high[1], "Liq Açık", style=label.style_label_down, color=color.red, textcolor=color.white)
                    array.push(supplyLabels, LabelSupply)       
                    BoxSupply = box.new(bar_index[1], high[1], bar_index[0] + 15, low[1], border_color=color.rgb(248, 72, 36), bgcolor=color.new(color.white, 90))//,extend = extend.right)
                    array.push(supplyZones, BoxSupply)
                    array.push(supplyTimestamps, bar_index)        
                else
                    LabelSupply = label.new(bar_index[0], high[0], "Liq Kapalı", style=label.style_label_down, color=color.red, textcolor=color.white)
                    array.push(supplyLabels, LabelSupply)
                    BoxSupply = box.new(bar_index[1], high, bar_index[0] + 15, low[1], border_color=color.rgb(248, 72, 36), bgcolor=color.new(color.white, 90))//,extend = extend.right)
                    array.push(supplyZones, BoxSupply)
                    array.push(supplyTimestamps, bar_index)

// Demand Zone tespiti
if (currentOpen < currentClose)
    if (previousOpen >= previousClose)
        //demand
        if (currentHigh > previousHigh)
            if bodyRate()
                if (previousLow < currentLow)
                    LabelDemand = label.new(bar_index[1], low[1], "Liq Açık", style=label.style_label_up, color=color.green, textcolor=color.white)
                    array.push(demandLabels, LabelDemand)
                    BoxDemand = box.new(bar_index[1], high[1], bar_index[0] + 15, low[1], border_color=#0ff51a, bgcolor=#ffffff1a)//,extend = extend.right )
                    array.push(demandZones, BoxDemand)
                    array.push(demandTimestamps, bar_index)
                else
                    LabelDemand = label.new(bar_index[1], low[1], "Liq kapalı", style=label.style_label_up, color=color.green, textcolor=color.white)
                    array.push(demandLabels, LabelDemand)
                    BoxDemand = box.new(bar_index[1], high[1], bar_index[0] + 15, low, border_color=#0ff51a, bgcolor=color.new(color.white, 90))//,extend = extend.right )
                    array.push(demandZones, BoxDemand)
                    array.push(demandTimestamps, bar_index)

// BodyRate değeri her bir mumun üzerine yazdırılıyor


// Orderblock tester fonksiyonu
orderblockTester() =>
    // Silinecek box'lar için geçici bir liste
    var box[] toDeleteSupply = array.new_box(0)
    var box[] toDeleteDemand = array.new_box(0)
    var label[] toDeleteSupplyLabel = array.new_label(0)
    var label[] toDeleteDemandLabel = array.new_label(0)

    // Supply bölgelerinin test edilmesi
    if array.size(supplyZones) > 0
        for i = 0 to array.size(supplyZones) - 1
            supplyZone = array.get(supplyZones, i)
            supplyTimestamp = array.get(supplyTimestamps, i)
            supplyLabel = array.get(supplyLabels, i)
            
            // supply zone'un kontrolü
            if (close >= box.get_bottom(supplyZone) or high >= box.get_bottom(supplyZone)) and bar_index - supplyTimestamp >= 1
                array.push(toDeleteSupply, supplyZone)
                array.push(toDeleteSupplyLabel, supplyLabel)

    // Demand bölgelerinin test edilmesi
    if array.size(demandZones) > 0
        for i = 0 to array.size(demandZones) - 1
            demandZone = array.get(demandZones, i)
            demandTimestamp = array.get(demandTimestamps, i)
            demandLabel = array.get(demandLabels, i)
            
            // demand zone'un kontrolü
            if (close <= box.get_top(demandZone) or low <= box.get_top(demandZone)) and bar_index - demandTimestamp >= 1
                array.push(toDeleteDemand, demandZone)
                array.push(toDeleteDemandLabel, demandLabel)

    // Silinecek supply box'larını grafikten kaldır ve diziden çıkar
    if array.size(toDeleteSupply) > 0
        for i = 0 to array.size(toDeleteSupply) - 1
            supplyZone = array.get(toDeleteSupply, i)
            box.delete(supplyZone)
            idx = array.indexof(supplyZones, supplyZone)
            if idx >= 0
                array.remove(supplyZones, idx)
                array.remove(supplyTimestamps, idx)
                supplyLabel = array.remove(supplyLabels, idx)
                label.delete(supplyLabel)

    // Silinecek demand box'larını grafikten kaldır ve diziden çıkar
    if array.size(toDeleteDemand) > 0
        for i = 0 to array.size(toDeleteDemand) - 1
            demandZone = array.get(toDeleteDemand, i)
            box.delete(demandZone)
            idx = array.indexof(demandZones, demandZone)
            if idx >= 0
                array.remove(demandZones, idx)
                array.remove(demandTimestamps, idx)
                demandLabel = array.remove(demandLabels, idx)
                label.delete(demandLabel)
            

orderblockTester()

// Order Block doğrulama fonksiyonu
isValidOrderBlock(supplyZone, demandZone) =>
    bool isValid = true
    
    // Kural 1: Untested olmalı
    // Kural 2: Giriş öncesi likidite kontrolü
    // Kural 3: IRL likidite kontrolü
    // Kural 4: Minimum swing hareketi
    // Kural 5: Likidite problemi kontrolü
    // Kural 6: FVG doluluk oranı kontrolü
    
    isValid

// Frontsuz giriş için IRL kontrolü
getLastIRL(supplyZone, demandZone) =>
    float irlPrice = na
    
    if strategy.position_size == 0
        // Short için IRL kontrolü
        if close >= box.get_bottom(supplyZone)
            // OB'nin altındaki son likidite noktasını bul
            for i = 1 to 10  // Son 10 mum içinde ara
                if low[i] < low[i-1] and low[i] < low[i+1]  // Lokal minimum
                    irlPrice := low[i]
                    break
    
        // Long için IRL kontrolü
        if close <= box.get_top(demandZone)
            // OB'nin üstündeki son likidite noktasını bul
            for i = 1 to 10  // Son 10 mum içinde ara
                if high[i] > high[i-1] and high[i] > high[i+1]  // Lokal maksimum
                    irlPrice := high[i]
                    break
    
    irlPrice

// Pozisyon yönetimi (Frontsuz giriş)
manageTrades() =>
    if array.size(supplyZones) > 0 and array.size(demandZones) > 0
        supplyZone = array.get(supplyZones, array.size(supplyZones) - 1)
        demandZone = array.get(demandZones, array.size(demandZones) - 1)
        
        if isValidOrderBlock(supplyZone, demandZone)
            irlPrice = getLastIRL(supplyZone, demandZone)
            
            // Long pozisyon için sinyal
            if strategy.position_size == 0 and close <= box.get_top(demandZone) and not na(irlPrice)
                entryPrice = irlPrice  // IRL'den giriş
                stopPrice = box.get_bottom(demandZone)
                riskAmount = math.abs(entryPrice - stopPrice)
                targetPrice = entryPrice + (riskAmount * riskRewardRatio)
                
                strategy.entry("Long", strategy.long, limit=irlPrice, comment="5M Long IRL")
                strategy.exit("Long Exit", "Long", stop=stopPrice, limit=targetPrice)
            
            // Short pozisyon için sinyal
            if strategy.position_size == 0 and close >= box.get_bottom(supplyZone) and not na(irlPrice)
                entryPrice = irlPrice  // IRL'den giriş
                stopPrice = box.get_top(supplyZone)
                riskAmount = math.abs(stopPrice - entryPrice)
                targetPrice = entryPrice - (riskAmount * riskRewardRatio)
                
                strategy.entry("Short", strategy.short, limit=irlPrice, comment="5M Short IRL")
                strategy.exit("Short Exit", "Short", stop=stopPrice, limit=targetPrice)

// Strateji yönetimini çağır
manageTrades()

/////////////////////////////////////////////////////////////////////////////////////